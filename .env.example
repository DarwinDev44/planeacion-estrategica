# Copia este archivo como `.env` y ajusta los valores.
# El `.env` real no se versiona; este ejemplo sí, para documentar qué
# variables necesita el proyecto.

# PIN de acceso a la vista /admin. Solo servidor: sin él, nadie entra.
ADMIN_PIN=

# Postgres (Neon) donde se guardan las respuestas del Momento 4.
# Con pooler para la aplicación; sin pooler para migraciones y carga inicial.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
